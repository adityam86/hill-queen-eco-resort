# ==============================================================================
# HILL QUEEN ECO RESORT — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE (GODADDY)
# Copy this file to .env or enter these key-values in GoDaddy cPanel "Setup Node.js App"
# IMPORTANT: DO NOT COMMIT REAL PRODUCTION PASSWORDS TO REPOSITORIES OR ZIP ARCHIVES
# ==============================================================================

# 1. Server Environment
NODE_ENV="production"
# Note: GoDaddy cPanel / Passenger sets PORT automatically. Default fallback is 3000.
PORT=3000

# 2. Production Database (cPanel MySQL Database)
# In cPanel -> MySQL Databases:
#   Create database (e.g. username_hqresort)
#   Create database user (e.g. username_hqadmin) and assign all privileges
# Format: mysql://<USER>:<PASSWORD>@localhost:3306/<DATABASE_NAME>
DATABASE_URL="mysql://username_hqadmin:REPLACE_WITH_STRONG_DB_PASSWORD@localhost:3306/username_hqresort"

# 3. Cryptographic Security Secrets (CRITICAL: Must be at least 32 characters in production)
# Generate via terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="GENERATE_A_MINIMUM_32_CHAR_RANDOM_SECRET_FOR_JWT_HERE"
ADMIN_SECRET_KEY="GENERATE_A_MINIMUM_32_CHAR_RANDOM_SECRET_FOR_ADMIN_HERE"

# Session Cookies
ADMIN_SESSION_COOKIE="hq_admin_session"
GATEKEEPER_COOKIE_NAME="hq_gatekeeper_pass"

# 4. Canonical Site URL & Verified Contacts
NEXT_PUBLIC_SITE_URL="https://hillqueenecoresorts.com"
NEXT_PUBLIC_DEFAULT_PHONE="9735888106"
NEXT_PUBLIC_DEFAULT_WHATSAPP="9735888106"
NEXT_PUBLIC_DEFAULT_EMAIL="hillqueenecoresort@gmail.com"

# 5. Optional Initial Owner Credentials for CLI Seeding (scripts/create-owner.mjs)
# OWNER_EMAIL="owner@hillqueenecoresorts.com"
# OWNER_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
# OWNER_USERNAME="owner"
# OWNER_NAME="Hill Queen Owner"

